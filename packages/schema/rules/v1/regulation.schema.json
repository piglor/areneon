{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:areneon:schema:rules:v1:regulation",
  "title": "Areneon regulation metadata record (ADR-007)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "regulation", "sources"],
  "properties": {
    "schema_version": { "const": 1 },
    "regulation": { "type": "string", "pattern": "^[A-Z0-9]+(-[A-Z0-9]+)*$" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "verified_on"],
        "properties": {
          "url": { "type": "string", "pattern": "^https://" },
          "verified_on": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        }
      }
    }
  }
}
