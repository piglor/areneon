{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:areneon:schema:contracts:v1:engine-data",
  "title": "EngineData",
  "description": "The game vocabularies and their numeric attributes, exported from the pinned engine's data for one format's mod (ADR-010 section 3). Every list is sorted by id and its position is the entry's vocabulary index. Its RFC 8785 SHA-256 is the engine-data hash, part of the encoder version: a pin bump that changes any engine data changes the hash. Sorted and unique ids and references that resolve are enforced by the reader (the contract profile has no uniqueItems or cross references).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "showdown_commit",
    "format_id",
    "mod",
    "types",
    "move_targets",
    "move_flags",
    "species",
    "moves",
    "items",
    "abilities",
    "statuses",
    "weathers",
    "terrains"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "showdown_commit": {
      "description": "The pinned engine commit the table was exported from.",
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "format_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+$"
    },
    "mod": {
      "description": "The engine data mod the format plays on.",
      "type": "string",
      "minLength": 1
    },
    "types": {
      "description": "Type vocabulary, sorted by id; the position is the type's index.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/TypeEntry"
      }
    },
    "move_targets": {
      "description": "Move target kinds, sorted, unique.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "move_flags": {
      "description": "Move flags, sorted, unique.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "species": {
      "description": "Species vocabulary (formes included), sorted by id; the position is the species' index.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/SpeciesEntry"
      }
    },
    "moves": {
      "description": "Move vocabulary, sorted by id.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/MoveEntry"
      }
    },
    "items": {
      "description": "Item vocabulary, sorted by id.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/ItemEntry"
      }
    },
    "abilities": {
      "description": "Ability vocabulary, sorted by id.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/AbilityEntry"
      }
    },
    "statuses": {
      "description": "Major status conditions, sorted by id.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/NamedEntry"
      }
    },
    "weathers": {
      "description": "Weather conditions, sorted by id.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/NamedEntry"
      }
    },
    "terrains": {
      "description": "Terrain conditions, sorted by id.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/NamedEntry"
      }
    }
  },
  "$defs": {
    "EngineId": {
      "description": "An engine id: lower case letters and digits.",
      "type": "string",
      "pattern": "^[a-z0-9]+$"
    },
    "NamedEntry": {
      "description": "A vocabulary entry that has no attributes.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/EngineId"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "TypeEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "damage_taken"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/EngineId"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "damage_taken": {
          "description": "How this type takes damage from each attacking type, in `types` order, as the engine codes it: 0 normal, 1 super effective, 2 resisted, 3 immune.",
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          }
        }
      }
    },
    "SpeciesEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "num",
        "base_species",
        "types",
        "base_stats",
        "weight_hg",
        "abilities"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/EngineId"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "num": {
          "type": "integer",
          "minimum": -1000000,
          "maximum": 1000000
        },
        "base_species": {
          "description": "The id of the species this is a forme of (itself for a base species).",
          "$ref": "#/$defs/EngineId"
        },
        "types": {
          "description": "Type ids, in the engine's order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/EngineId"
          },
          "minItems": 1,
          "maxItems": 2
        },
        "base_stats": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hp",
            "atk",
            "def",
            "spa",
            "spd",
            "spe"
          ],
          "properties": {
            "hp": {
              "type": "integer",
              "minimum": 1,
              "maximum": 255
            },
            "atk": {
              "type": "integer",
              "minimum": 1,
              "maximum": 255
            },
            "def": {
              "type": "integer",
              "minimum": 1,
              "maximum": 255
            },
            "spa": {
              "type": "integer",
              "minimum": 1,
              "maximum": 255
            },
            "spd": {
              "type": "integer",
              "minimum": 1,
              "maximum": 255
            },
            "spe": {
              "type": "integer",
              "minimum": 1,
              "maximum": 255
            }
          }
        },
        "weight_hg": {
          "description": "Weight in hectograms (the engine's weighthg).",
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "abilities": {
          "description": "Ability ids in the engine's slot order (0, 1, H, S).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/EngineId"
          },
          "minItems": 1,
          "maxItems": 4
        }
      }
    },
    "MoveEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "num",
        "type",
        "category",
        "base_power",
        "accuracy",
        "always_hits",
        "priority",
        "pp",
        "crit_ratio",
        "target",
        "flags"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/EngineId"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "num": {
          "type": "integer",
          "minimum": -1000000,
          "maximum": 1000000
        },
        "type": {
          "$ref": "#/$defs/EngineId"
        },
        "category": {
          "enum": [
            "Physical",
            "Special",
            "Status"
          ]
        },
        "base_power": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "accuracy": {
          "description": "Percent; 0 when `always_hits`.",
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "always_hits": {
          "type": "boolean"
        },
        "priority": {
          "type": "integer",
          "minimum": -8,
          "maximum": 8
        },
        "pp": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "crit_ratio": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "target": {
          "description": "One of `move_targets`.",
          "type": "string",
          "minLength": 1
        },
        "flags": {
          "description": "Sorted members of `move_flags`.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "ItemEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "num",
        "is_berry",
        "fling_power"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/EngineId"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "num": {
          "type": "integer",
          "minimum": -1000000,
          "maximum": 1000000
        },
        "is_berry": {
          "type": "boolean"
        },
        "fling_power": {
          "description": "0 when the item cannot be flung.",
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      }
    },
    "AbilityEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "num"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/EngineId"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "num": {
          "type": "integer",
          "minimum": -1000000,
          "maximum": 1000000
        }
      }
    }
  }
}
