{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:areneon:schema:contracts:v1:mechanics-query",
  "title": "MechanicsQuery",
  "description": "A question to the mechanics probe (ADR-016 section 2): declared sets and declared state, never a battle. The probe asks the pinned engine on a scenario battle built from them; it takes no Battle, BattleRecord, OmniscientLog, PlayerChannel or opponent's real set, and an opponent's set in an analysis is stated here as an assumption. Sets are PokePaste in the engine's canonical form (as importPaste accepts it), one Pokemon per set. State uses engine ids; boosts are absolute stages set after the battle starts, so a switch-in effect is replaced by the declared value, never added silently. data_class is synthetic or private: a query holding a private set is private and is never committed. query_hash is the SHA-256 of this document's JCS bytes. A document that fails this schema is not a query: the CLI reports an error and writes no result.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "data_class",
    "format_id",
    "query"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "data_class": {
      "description": "synthetic: CC0, may be committed; private: a real team or a human's games, kept only in private-data/ (ADR-008 section 5).",
      "enum": [
        "synthetic",
        "private"
      ]
    },
    "format_id": {
      "description": "The target format (a format of the rules snapshot).",
      "type": "string",
      "pattern": "^[a-z0-9]+$"
    },
    "query": {
      "description": "The question, tagged by kind: stats (the six stats of one set), speed_order (the turn order of up to two Pokemon per side), damage (two 16-roll vectors and the KO counts of one move) or move_outcome (whether a move works and with what chance).",
      "type": "object",
      "oneOf": [
        {
          "$ref": "#/$defs/StatsQuery"
        },
        {
          "$ref": "#/$defs/SpeedOrderQuery"
        },
        {
          "$ref": "#/$defs/DamageQuery"
        },
        {
          "$ref": "#/$defs/MoveOutcomeQuery"
        }
      ],
      "discriminator": {
        "propertyName": "kind"
      }
    }
  },
  "$defs": {
    "Paste": {
      "description": "One Pokemon as PokePaste in the engine's canonical form.",
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "Boosts": {
      "description": "Absolute stat stages, set after the battle starts.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "atk",
        "def",
        "spa",
        "spd",
        "spe"
      ],
      "properties": {
        "atk": {
          "type": "integer",
          "minimum": -6,
          "maximum": 6
        },
        "def": {
          "type": "integer",
          "minimum": -6,
          "maximum": 6
        },
        "spa": {
          "type": "integer",
          "minimum": -6,
          "maximum": 6
        },
        "spd": {
          "type": "integer",
          "minimum": -6,
          "maximum": 6
        },
        "spe": {
          "type": "integer",
          "minimum": -6,
          "maximum": 6
        }
      }
    },
    "Combatant": {
      "description": "One Pokemon with its declared state.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "set",
        "boosts",
        "status",
        "hp",
        "mega"
      ],
      "properties": {
        "set": {
          "$ref": "#/$defs/Paste"
        },
        "boosts": {
          "$ref": "#/$defs/Boosts"
        },
        "status": {
          "description": "The engine's id of the major status, or null.",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9]+$"
        },
        "hp": {
          "description": "The current HP, or null for full HP.",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 9999
        },
        "mega": {
          "description": "True when the Pokemon has Mega Evolved or does so this turn, as the query kind says.",
          "type": "boolean"
        },
        "history": {
          "$ref": "#/$defs/CombatantHistory"
        }
      }
    },
    "SideState": {
      "description": "The conditions on one side.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aurora_veil",
        "light_screen",
        "reflect",
        "tailwind"
      ],
      "properties": {
        "aurora_veil": {
          "type": "boolean"
        },
        "light_screen": {
          "type": "boolean"
        },
        "reflect": {
          "type": "boolean"
        },
        "tailwind": {
          "type": "boolean"
        }
      }
    },
    "FieldState": {
      "description": "The declared field.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "weather",
        "terrain",
        "trick_room",
        "sides"
      ],
      "properties": {
        "weather": {
          "description": "The engine's weather id, or null.",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9]+$"
        },
        "terrain": {
          "description": "The engine's terrain id, or null.",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9]+$"
        },
        "trick_room": {
          "type": "boolean"
        },
        "sides": {
          "description": "Side 0 then side 1.",
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/SideState"
          }
        }
      }
    },
    "Action": {
      "description": "One Pokemon's action this turn.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "side",
        "position",
        "move",
        "mega"
      ],
      "properties": {
        "side": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "position": {
          "description": "The index of the acting Pokemon in its side's list.",
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "move": {
          "description": "The engine's move id, or null for a switch.",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9]+$"
        },
        "mega": {
          "description": "True when the action Mega Evolves first.",
          "type": "boolean"
        }
      }
    },
    "StatsQuery": {
      "description": "The six stats of one set at the format's level.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "set"
      ],
      "properties": {
        "kind": {
          "const": "stats"
        },
        "set": {
          "$ref": "#/$defs/Paste"
        }
      }
    },
    "SpeedOrderQuery": {
      "description": "The turn order of the declared actions.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "sides",
        "actions",
        "state"
      ],
      "properties": {
        "kind": {
          "const": "speed_order"
        },
        "sides": {
          "description": "Side 0 then side 1, one or two Pokemon each.",
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {
              "$ref": "#/$defs/Combatant"
            }
          }
        },
        "actions": {
          "description": "One action per acting Pokemon.",
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/Action"
          }
        },
        "state": {
          "$ref": "#/$defs/FieldState"
        },
        "history": {
          "$ref": "#/$defs/BattleHistory"
        }
      }
    },
    "DamageQuery": {
      "description": "One move from the attacker into the defender.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "attacker",
        "defender",
        "move",
        "state"
      ],
      "properties": {
        "kind": {
          "const": "damage"
        },
        "attacker": {
          "$ref": "#/$defs/Combatant"
        },
        "defender": {
          "$ref": "#/$defs/Combatant"
        },
        "move": {
          "description": "The engine's move id.",
          "type": "string",
          "pattern": "^[a-z0-9]+$"
        },
        "state": {
          "$ref": "#/$defs/FieldState"
        },
        "history": {
          "$ref": "#/$defs/BattleHistory"
        }
      }
    },
    "Count": {
      "description": "A non-negative count.",
      "type": "integer",
      "minimum": 0,
      "maximum": 9999
    },
    "Attacker": {
      "description": "A Pokemon that hit the declared Pokemon this turn: its side and position in the query's sides, and the damage it dealt (the engine's attackedBy entry).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "side",
        "position",
        "damage"
      ],
      "properties": {
        "side": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "position": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "damage": {
          "$ref": "#/$defs/Count"
        }
      }
    },
    "VolatileEntry": {
      "description": "A volatile the Pokemon holds, added through the engine's own addVolatile. started_turn and after_residual date it as the world facts do; starts (default 1) is how many times the engine's start handler ran (a stacking volatile such as Stockpile restarts once per layer).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "started_turn",
        "after_residual"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+$"
        },
        "started_turn": {
          "$ref": "#/$defs/Count"
        },
        "after_residual": {
          "type": "boolean"
        },
        "starts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9
        }
      }
    },
    "SlotEntry": {
      "description": "A timed slot condition (Wish, Future Sight) at a position of a side, started at started_turn.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "id",
        "started_turn",
        "after_residual"
      ],
      "properties": {
        "position": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+$"
        },
        "started_turn": {
          "$ref": "#/$defs/Count"
        },
        "after_residual": {
          "type": "boolean"
        }
      }
    },
    "KnownCount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "known"
        },
        "value": {
          "$ref": "#/$defs/Count"
        }
      }
    },
    "UnknownCount": {
      "description": "The channel cannot settle the fact (an Illusion, a hit whose source is not shown). The probe asks the query with the fact at each of its two ends; equal answers are kept, different answers are unsupported (history_unknown).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ends"
      ],
      "properties": {
        "kind": {
          "const": "unknown"
        },
        "ends": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/Count"
          }
        }
      }
    },
    "CountFact": {
      "type": "object",
      "oneOf": [
        {
          "$ref": "#/$defs/KnownCount"
        },
        {
          "$ref": "#/$defs/UnknownCount"
        }
      ],
      "discriminator": {
        "propertyName": "kind"
      }
    },
    "KnownBool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "known"
        },
        "value": {
          "type": "boolean"
        }
      }
    },
    "UnknownBool": {
      "description": "The channel cannot settle the fact (an Illusion, a hit whose source is not shown). The probe asks the query with the fact at each of its two ends; equal answers are kept, different answers are unsupported (history_unknown).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ends"
      ],
      "properties": {
        "kind": {
          "const": "unknown"
        },
        "ends": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "boolean"
          }
        }
      }
    },
    "BoolFact": {
      "type": "object",
      "oneOf": [
        {
          "$ref": "#/$defs/KnownBool"
        },
        {
          "$ref": "#/$defs/UnknownBool"
        }
      ],
      "discriminator": {
        "propertyName": "kind"
      }
    },
    "KnownId": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "known"
        },
        "value": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9]+$"
        }
      }
    },
    "UnknownId": {
      "description": "The channel cannot settle the fact (an Illusion, a hit whose source is not shown). The probe asks the query with the fact at each of its two ends; equal answers are kept, different answers are unsupported (history_unknown).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ends"
      ],
      "properties": {
        "kind": {
          "const": "unknown"
        },
        "ends": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-z0-9]+$"
          }
        }
      }
    },
    "IdFact": {
      "type": "object",
      "oneOf": [
        {
          "$ref": "#/$defs/KnownId"
        },
        {
          "$ref": "#/$defs/UnknownId"
        }
      ],
      "discriminator": {
        "propertyName": "kind"
      }
    },
    "KnownAttackers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "known"
        },
        "value": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/Attacker"
          }
        }
      }
    },
    "UnknownAttackers": {
      "description": "The channel cannot settle the fact (an Illusion, a hit whose source is not shown). The probe asks the query with the fact at each of its two ends; equal answers are kept, different answers are unsupported (history_unknown).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ends"
      ],
      "properties": {
        "kind": {
          "const": "unknown"
        },
        "ends": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "$ref": "#/$defs/Attacker"
            }
          }
        }
      }
    },
    "AttackersFact": {
      "type": "object",
      "oneOf": [
        {
          "$ref": "#/$defs/KnownAttackers"
        },
        {
          "$ref": "#/$defs/UnknownAttackers"
        }
      ],
      "discriminator": {
        "propertyName": "kind"
      }
    },
    "KnownIds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "known"
        },
        "value": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+$"
          }
        }
      }
    },
    "UnknownIds": {
      "description": "The channel cannot settle the fact (an Illusion, a hit whose source is not shown). The probe asks the query with the fact at each of its two ends; equal answers are kept, different answers are unsupported (history_unknown).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ends"
      ],
      "properties": {
        "kind": {
          "const": "unknown"
        },
        "ends": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+$"
            }
          }
        }
      }
    },
    "IdsFact": {
      "type": "object",
      "oneOf": [
        {
          "$ref": "#/$defs/KnownIds"
        },
        {
          "$ref": "#/$defs/UnknownIds"
        }
      ],
      "discriminator": {
        "propertyName": "kind"
      }
    },
    "KnownVolatiles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "known"
        },
        "value": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/VolatileEntry"
          }
        }
      }
    },
    "UnknownVolatiles": {
      "description": "The channel cannot settle the fact (an Illusion, a hit whose source is not shown). The probe asks the query with the fact at each of its two ends; equal answers are kept, different answers are unsupported (history_unknown).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ends"
      ],
      "properties": {
        "kind": {
          "const": "unknown"
        },
        "ends": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "$ref": "#/$defs/VolatileEntry"
            }
          }
        }
      }
    },
    "VolatilesFact": {
      "type": "object",
      "oneOf": [
        {
          "$ref": "#/$defs/KnownVolatiles"
        },
        {
          "$ref": "#/$defs/UnknownVolatiles"
        }
      ],
      "discriminator": {
        "propertyName": "kind"
      }
    },
    "KnownSlots": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "known"
        },
        "value": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/SlotEntry"
          }
        }
      }
    },
    "UnknownSlots": {
      "description": "The channel cannot settle the fact (an Illusion, a hit whose source is not shown). The probe asks the query with the fact at each of its two ends; equal answers are kept, different answers are unsupported (history_unknown).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ends"
      ],
      "properties": {
        "kind": {
          "const": "unknown"
        },
        "ends": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "$ref": "#/$defs/SlotEntry"
            }
          }
        }
      }
    },
    "SlotsFact": {
      "type": "object",
      "oneOf": [
        {
          "$ref": "#/$defs/KnownSlots"
        },
        {
          "$ref": "#/$defs/UnknownSlots"
        }
      ],
      "discriminator": {
        "propertyName": "kind"
      }
    },
    "CombatantHistory": {
      "description": "The history facts of one Pokemon (ADR-022 erratum E-22.5.2), each declared through the engine's own field. A fact left out keeps the scenario's fresh value. Opponent PP is never declared.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "move_actions": {
          "description": "activeMoveActions: the move actions it has run since it switched in (before the asked action).",
          "$ref": "#/$defs/CountFact"
        },
        "stall_counter": {
          "description": "The stall condition's counter (the engine's own: 0 is no stall volatile).",
          "$ref": "#/$defs/CountFact"
        },
        "times_attacked": {
          "description": "timesAttacked.",
          "$ref": "#/$defs/CountFact"
        },
        "hurt_this_turn": {
          "description": "hurtThisTurn is set.",
          "$ref": "#/$defs/BoolFact"
        },
        "attacked_by": {
          "description": "attackedBy: the Pokemon that hit it this turn.",
          "$ref": "#/$defs/AttackersFact"
        },
        "last_move_failed": {
          "description": "moveLastTurnResult is false.",
          "$ref": "#/$defs/BoolFact"
        },
        "stats_raised_this_turn": {
          "description": "statsRaisedThisTurn.",
          "$ref": "#/$defs/BoolFact"
        },
        "stats_lowered_this_turn": {
          "description": "statsLoweredThisTurn.",
          "$ref": "#/$defs/BoolFact"
        },
        "ate_berry": {
          "description": "ateBerry.",
          "$ref": "#/$defs/BoolFact"
        },
        "last_item": {
          "description": "lastItem: the engine's id of the last item it used or ate, or null.",
          "$ref": "#/$defs/IdFact"
        },
        "moves_used": {
          "description": "moveSlots[].used: the ids of its moves it has used since it switched in.",
          "$ref": "#/$defs/IdsFact"
        },
        "volatiles": {
          "description": "Volatiles it holds, with their ages.",
          "$ref": "#/$defs/VolatilesFact"
        }
      }
    },
    "SideHistory": {
      "description": "The history facts of one side.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "total_fainted": {
          "description": "side.totalFainted.",
          "$ref": "#/$defs/CountFact"
        },
        "pending_slots": {
          "description": "The timed slot conditions pending on the side.",
          "$ref": "#/$defs/SlotsFact"
        }
      }
    },
    "BattleHistory": {
      "description": "History facts of the battle and its sides, declared through the engine's own fields (ADR-022 erratum E-22.5.3). Optional on every kind; a query without it keeps its bytes and its answer.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "turn": {
          "description": "The battle's turn; required when a volatile or a slot condition is declared, so its remaining turns are the engine's own length less the turns since it began.",
          "$ref": "#/$defs/Count"
        },
        "field_last_move": {
          "description": "battle.lastMove: the engine's id of the battle's last move, or null.",
          "$ref": "#/$defs/IdFact"
        },
        "sides": {
          "description": "Side 0 then side 1.",
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/SideHistory"
          }
        }
      }
    },
    "TargetRef": {
      "description": "One declared Pokemon: its side and its index in the side's list.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "side",
        "position"
      ],
      "properties": {
        "side": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "position": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "MoveOutcomeQuery": {
      "description": "Whether the asked action's move works, and with what chance, given the other actions queued this turn (one opposing-action branch). The engine's own move step runs for the asked action with a random source that answers every chance with success and records each (n, d): the precondition chance is the product of the draws made before the hit step, the hit chance the accuracy draw of the target. A move that never reaches its hit step fails.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "sides",
        "actions",
        "asked",
        "target",
        "state"
      ],
      "properties": {
        "kind": {
          "const": "move_outcome"
        },
        "sides": {
          "description": "Side 0 then side 1, one or two Pokemon each.",
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {
              "$ref": "#/$defs/Combatant"
            }
          }
        },
        "actions": {
          "description": "The actions queued this turn, the asked one included. The engine's own order decides which stay in the queue after the asked one.",
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/Action"
          }
        },
        "asked": {
          "description": "The index in actions of the asked action (a move).",
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "target": {
          "$ref": "#/$defs/TargetRef"
        },
        "state": {
          "$ref": "#/$defs/FieldState"
        },
        "history": {
          "$ref": "#/$defs/BattleHistory"
        }
      }
    }
  }
}
