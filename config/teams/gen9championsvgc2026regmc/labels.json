{
  "schema_version": 1,
  "label_set_id": "coverage-v1",
  "labels": [
    {
      "label_id": "speed_control",
      "values": [
        {
          "value": "both",
          "when": {
            "kind": "all_of",
            "of": [
              {
                "kind": "has_move",
                "moves": [
                  "trickroom"
                ]
              },
              {
                "kind": "has_move",
                "moves": [
                  "tailwind"
                ]
              }
            ]
          }
        },
        {
          "value": "trick_room",
          "when": {
            "kind": "has_move",
            "moves": [
              "trickroom"
            ]
          }
        },
        {
          "value": "tailwind",
          "when": {
            "kind": "has_move",
            "moves": [
              "tailwind"
            ]
          }
        }
      ],
      "default": "neither"
    },
    {
      "label_id": "weather_terrain_setter",
